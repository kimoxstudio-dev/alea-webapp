# See docs/ENVIRONMENT.md for the full variable reference (scope, required/
# optional, defaults, where each value is obtained) and the Preview/Production
# split. This file only covers what the app runtime and its scripts read.

# ============================================================
# NEON (PostgreSQL)
# Dashboard: console.neon.tech → your project → Connection Details
# ============================================================

# Pooled connection string, used by lib/db/client.ts for all application
# queries. Include ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ============================================================
# CLERK
# Dashboard: dashboard.clerk.com → your application → API Keys
# ============================================================

# Publishable key — safe to expose in the browser. Read implicitly by
# @clerk/nextjs, not via an explicit process.env reference in this repo.
# Location: API Keys → Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Secret key — SERVER ONLY, never expose to the browser. Read implicitly by
# @clerk/nextjs (middleware.ts, lib/server/auth-service.ts via clerkClient),
# and explicitly by scripts/seed-dev.mjs to create the seeded admin identity.
# Location: API Keys → Secret keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Sign-in / sign-up route path overrides — read implicitly by @clerk/nextjs,
# not referenced anywhere in this repo's own code. Left unset by default:
# routes are locale-prefixed pages under app/[locale]/sign-in and sign-up,
# resolved at request time. Set only if a fixed (non-locale) path is needed.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up

# ============================================================
# VERCEL BLOB
# Dashboard: vercel.com → your project → Storage → Blob store → .env.local tab
# ============================================================

# Read/write token for the Blob store. Read implicitly by the @vercel/blob
# SDK's put() call in lib/server/uploads-service.ts (admin image uploads for
# events/partners/library games) and lib/server/tables-service.ts (table QR
# code generation) — not via an explicit process.env reference in this repo.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ============================================================
# APPLICATION
# ============================================================

# Base URL of the app. Despite the NEXT_PUBLIC_ prefix this is only read
# server-side in this repo: lib/server/tables-service.ts and
# lib/server/rooms-service.ts use it to build the QR-code check-in URL
# (`${appUrl}/check-in/:tableId`). Required for table QR code generation —
# generateTableQrCode()/regenerateQrCodes() return 500 if it's unset.
# It does NOT drive auth callbacks or the cookie Secure flag (see
# COOKIE_SECURE below for that).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Controls the `Secure` flag on auth and CSRF cookies. Evaluated at RUNTIME (not build time),
# so the same build artifact works correctly on both HTTP staging and HTTPS production.
# Set to `true` on any deployment that is served over HTTPS.
# If unset, defaults to `true` when NODE_ENV=production and `false` otherwise — leave this
# unset in production so a deployed HTTPS environment never accidentally ships insecure cookies.
# For local HTTP dev only, uncomment the next line:
# COOKIE_SECURE=false

# Enable this only when the deployment ingress strips and rewrites both `x-real-ip`
# and `x-forwarded-for` before requests reach the app runtime.
TRUST_PROXY_HEADERS=false

# Comma-separated CIDR allowlist for reverse proxies that are permitted to supply `x-forwarded-for`.
# Only requests arriving from one of these source IP ranges will trust the first forwarded address for rate limiting,
# and only when TRUST_PROXY_HEADERS=true. Everything else falls back to `x-real-ip` (or `local` if unavailable).
# Set this explicitly in deployed environments, and ensure your ingress strips and overwrites inbound `x-real-ip`
# and `x-forwarded-for`.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional API base URL override for the frontend.
# If unset, the runtime defaults to `/api`.
# Only set this when the browser should call a different API base URL.
NEXT_PUBLIC_API_URL=/api

# External URL for the association link in the footer
NEXT_PUBLIC_ASSOCIATION_URL=

# Club timezone override (IANA name, e.g. Atlantic/Canary). Read by
# lib/club-time.ts. Defaults to 'Atlantic/Canary' if neither this nor
# NEXT_PUBLIC_CLUB_TIMEZONE below is set — NOT the server's system timezone.
# CLUB_TIMEZONE=

# Same override, exposed to the browser. lib/club-time.ts is imported by
# client components (e.g. components/rooms/rooms-view.tsx), so a
# server-only CLUB_TIMEZONE is invisible to them — set this too if the
# club's timezone needs to be anything other than the default in the UI.
# Takes precedence over CLUB_TIMEZONE when both are set.
# NEXT_PUBLIC_CLUB_TIMEZONE=

# ============================================================
# RATE LIMITING (optional — shared store via Upstash Redis)
# ============================================================

# When both variables are set, the rate limiter uses Upstash Redis (sliding-window,
# shared across all serverless instances). Without them, an in-memory Map is used
# (per-instance only — fine for local dev and tests, but bypassable in production
# by rotating instances).
# Dashboard: console.upstash.com → your Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# CRON
# ============================================================

# Currently unused: POST /api/cron/cancel-pending unconditionally returns 410 and
# never reads this header. Kept defined pending a decision on whether the route is
# revived with auth restored or removed outright — see docs/SECRET-ROTATION-CHECKLIST.md.
CRON_SECRET=your-random-cron-secret

# ============================================================
# SCRIPTS ONLY — read by scripts/*.mjs, not by the app runtime
# ============================================================

# scripts/apply-neon-schema.mjs: skip the empty-database guard and apply
# schema files even when tables already exist. Optional, defaults to off
# (the guard fails closed).
# ALLOW_NON_EMPTY_DB=1

# scripts/seed-dev.mjs: initial password for the seeded admin Clerk
# identity. Required to run the script — no default.
# SEED_ADMIN_PASSWORD=

# scripts/seed-dev.mjs: exact confirmation value the script checks for
# before writing to the database, as a safety gate against running it
# against the wrong environment. Required to run the script — no default.
# See scripts/seed-dev.mjs for the exact string it expects.
# DEV_SEED_CONFIRM=

# ============================================================
# E2E ONLY — read by qa/e2e/*.mjs from a dedicated .env.e2e.local at the
# repo root (NOT loaded from .env.local — see qa/e2e/README.md). Listed
# here for discoverability only; do not add these to .env.local.
# ============================================================

# E2E_BASE_URL=http://localhost:3001
# E2E_DATABASE_HOST=
# E2E_ALLOW_DESTRUCTIVE=1
# CHROME_PATH=
# PLAYWRIGHT_QA_USER=
# PLAYWRIGHT_QA_PASSWORD=
# PLAYWRIGHT_QA_SECONDARY_USER=
# PLAYWRIGHT_QA_SECONDARY_PASSWORD=
